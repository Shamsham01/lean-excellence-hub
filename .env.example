# Publishable local Supabase values only. Never add secret or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only values. Never prefix these with NEXT_PUBLIC_ or commit real values.
APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_SECRET_KEY=replace-with-local-secret-key
AUTH_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters
# Lean AI (server-only). Set AI_ENABLED=1 and configure provider for local OpenAI tests.
AI_ENABLED=0
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL_DEFAULT=gpt-6.1-sol
# Logical model classes (server-only). Never expose mapping or credentials to the browser.
# Official OpenAI API IDs — not ChatGPT product names. Checked 2026-10-26.
# gpt-4.1-nano was retired on 2026-10-23. Do not restore it.
AI_MODEL_ECONOMY=gpt-6-luna
AI_MODEL_STANDARD=gpt-6.1-terra
AI_MODEL_DEEP=gpt-6.1-sol
# Optional. When set, this replaces every workflow reasoning default and does
# not change the model. Leave unset to use task defaults: explain none,
# workspace and module setup low, maturity and problem solving medium,
# challenge high. gpt-6.1-sol rejects none; that effort is rewritten to low.
# AI_MODEL_REASONING=low
AI_RUN_TIMEOUT_MS=45000
AI_MAX_TOOL_CALLS=8
# Optional ceiling. Unset uses each workflow's reasoning-inclusive budget
# (explain 1500; maturity and problem solving 10000 at their default effort).
# A value of 6000 can truncate medium reasoning. It cannot select another model.
# AI_MAX_OUTPUT_TOKENS=10000
# Test-only fake provider gate (NODE_ENV=test also required).
AI_ALLOW_FAKE_PROVIDER=0
# Set only when the deployment edge overwrites this header.
TRUSTED_PROXY_IP_HEADER=

# Billing (server-only). Never prefix Stripe secrets with NEXT_PUBLIC_.
# Set BILLING_PROVIDER=fake explicitly for local/CI/test. Unset provider never
# falls back to fake; a deployed environment without Stripe config fails closed.
# Stripe Sandbox only; never sk_live.
BILLING_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIALS_MONTHLY=
STRIPE_PRICE_ESSENTIALS_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_FOUNDER_ANNUAL=

# Public Cal.com booking link for /demo. No API secret is required, and none
# belongs in a NEXT_PUBLIC_ variable. Leave empty until an approved Lean
# Excellence Hub privacy notice is published and linked from /demo, and the
# organiser has published a real link. Do not invent that notice. See
# docs/sales/LEH-DEMO-BOOKING-SETUP.md. HTTPS only, on cal.com or cal.eu
# (including subdomains such as app.cal.com). Next.js inlines this at build
# time, so a change needs a new build.
# Shape, not a real account: https://cal.com/<organiser>/<event-slug>
NEXT_PUBLIC_DEMO_BOOKING_URL=
# Playwright only. Never set this on a deployed environment.
# DEMO_BOOKING_E2E=1

# Edge Function secrets for custom auth email delivery live in supabase/functions/.env.
# See supabase/functions/.env.example and docs/development/custom-auth-email-delivery.md.
