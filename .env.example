# Publishable local Supabase values only. Never add secret or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only values. Never prefix these with NEXT_PUBLIC_ or commit real values.
APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_SECRET_KEY=replace-with-local-secret-key
AUTH_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters
# Lean AI (server-only). Set AI_ENABLED=1 and configure provider for local OpenAI tests.
AI_ENABLED=0
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL_DEFAULT=gpt-4.1-mini
AI_RUN_TIMEOUT_MS=45000
AI_MAX_TOOL_CALLS=8
AI_MAX_OUTPUT_TOKENS=2048
# Test-only fake provider gate (NODE_ENV=test also required).
AI_ALLOW_FAKE_PROVIDER=0
# Set only when the deployment edge overwrites this header.
TRUSTED_PROXY_IP_HEADER=
