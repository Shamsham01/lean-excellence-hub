{
  "name": "lean-excellence-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Lean Excellence Hub application and tooling baseline.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/application-shell.spec.ts tests/e2e/authentication-shell.spec.ts tests/e2e/maturity-shell.spec.ts",
    "test:e2e:install": "playwright install chromium",
    "test:db": "supabase test db --local supabase/tests/database",
    "test:db:integration": "node --import tsx scripts/test-n1a-worker-api-integration.ts",
    "test:db:integration:n1b": "node --import tsx scripts/test-n1b-notification-projector-integration.ts",
    "test:db:integration:n1c": "node --import tsx scripts/test-n1c-notification-delivery-integration.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:types": "supabase gen types typescript --local --schema public > src/platform/supabase/database.types.ts",
    "db:seed-demo": "node --import tsx scripts/demo-seed/seed.ts",
    "qa:cookie:seed": "node --import tsx scripts/qa-tenant/seed.ts",
    "qa:cookie:reset": "node --import tsx scripts/qa-tenant/reset.ts",
    "qa:cookie:inventory": "node --import tsx scripts/qa-tenant/inventory-cli.ts",
    "qa:cookie:hosted-reset": "node --import tsx scripts/qa-tenant/hosted-reset.ts",
    "qa:cookie:hosted-seed": "node --import tsx scripts/qa-tenant/hosted-seed.ts",
    "qa:cookie:hosted-replacement": "node --import tsx scripts/qa-tenant/hosted-replacement.ts",
    "qa:verify:clean-rebuild": "node --import tsx scripts/qa-tenant/verify-clean-rebuild.ts",
    "eval:ai:fake": "node --import tsx scripts/eval-ai-fake.ts",
    "eval:ai:live": "node --env-file=.env.local --import tsx scripts/eval-ai-live.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shamsham01/lean-excellence-hub.git"
  },
  "bugs": {
    "url": "https://github.com/Shamsham01/lean-excellence-hub/issues"
  },
  "homepage": "https://github.com/Shamsham01/lean-excellence-hub#readme",
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@testing-library/dom": "^10.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "openai": "^7.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "standardwebhooks": "^1.0.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
