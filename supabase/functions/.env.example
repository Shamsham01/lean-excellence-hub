# Edge Function secrets for custom auth email delivery.
# Copy to supabase/functions/.env for local `supabase functions serve send-email --no-verify-jwt`.
# Do not commit real values.

RESEND_API_KEY=re_replace_with_resend_api_key
SEND_EMAIL_HOOK_SECRET="v1,whsec_replace_with_generated_hook_secret"
APP_ORIGIN=http://127.0.0.1:3000
AUTH_EMAIL_FROM=onboarding@resend.dev
AUTH_EMAIL_FROM_NAME=Lean Excellence Hub
